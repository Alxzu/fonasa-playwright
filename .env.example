# BPS Company Data
BPS_EMPRESA=1234567
BPS_RUT=123456789012

# Holder Data
BPS_DOCUMENTO=12345678
BPS_FECHA_NAC_DIA=17
BPS_FECHA_NAC_MES=Jul
BPS_FECHA_NAC_ANIO=1990

# Invoice Settings
# Options: IRPF, IRAE, IRPF e IRAE
BPS_IMPUESTO=IRPF

# Amount in USD (will be converted to UYU using BCU exchange rate)
BPS_MONTO_USD=10000

# Exchange Rate API (optional, defaults to BCU proxy)
EXCHANGE_RATE_API=https://bcu.alxzu.duckdns.org/usd-rate

# Output directory for PDFs
OUTPUT_DIR=./output

# Browser settings (true = headless, false = visible browser)
HEADLESS=true
