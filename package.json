{
  "name": "fonasa-playwright",
  "version": "1.0.0",
  "description": "Automate BPS FONASA invoice generation using Playwright",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "install:browser": "bunx playwright install chromium",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/bun": "^1.3.14"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "playwright": "^1.62.1"
  }
}
