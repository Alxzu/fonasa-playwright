{
  "name": "fonasa-playwright",
  "version": "1.0.0",
  "description": "Automate BPS FONASA invoice generation using Playwright",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "install:browser": "bunx playwright install chromium",
    "preflight": "bun run scripts/preflight.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:selectors": "bun test test/selectors",
    "test:e2e": "bun test test/e2e",
    "mock": "bun run test/mock-bps/cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/bun": "^1.3.14"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "playwright": "^1.62.1"
  }
}
